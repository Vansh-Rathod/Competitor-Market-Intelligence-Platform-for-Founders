PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Data collection provider configuration
DATA_COLLECTION_PROVIDER=brave
BRAVE_API_KEY=
BRAVE_API_BASE_URL=https://api.search.brave.com/res/v1/web/search
DATA_COLLECTION_MAX_QUERIES=8
DATA_COLLECTION_MAX_RESULTS_PER_QUERY=5
DATA_COLLECTION_TIMEOUT_MS=6000
DATA_COLLECTION_RETRY_ATTEMPTS=2
DATA_COLLECTION_RETRY_BASE_DELAY_MS=300

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_ZIPPED_ARCHIVE=true
LOG_SERVICE_NAME=market-intel-backend
